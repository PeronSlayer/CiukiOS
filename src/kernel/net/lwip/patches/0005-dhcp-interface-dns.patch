--- a/src/core/ipv4/dhcp.c
+++ b/src/core/ipv4/dhcp.c
@@ -742,9 +742,17 @@
     ip_addr_set_ip4_u32_val(dns_addr, lwip_htonl(dhcp_get_option_value(dhcp, DHCP_OPTION_IDX_DNS_SERVER + n)));
+#ifdef LWIP_HOOK_DHCP_DNS_SERVER
+    LWIP_HOOK_DHCP_DNS_SERVER(netif, n, ip4_addr_get_u32(ip_2_ip4(&dns_addr)));
+#else
     dns_setserver(n, &dns_addr);
+#endif
   }
   /* A lease ACK replaces the complete DNS list, including omitted slots. */
   for (; n < DNS_MAX_SERVERS; n++) {
+#ifdef LWIP_HOOK_DHCP_DNS_SERVER
+    LWIP_HOOK_DHCP_DNS_SERVER(netif, n, 0);
+#else
     dns_setserver(n, IP_ADDR_ANY);
+#endif
   }
 #endif /* LWIP_DHCP_PROVIDE_DNS_SERVERS */
 }
