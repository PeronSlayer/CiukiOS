+/* Ciuki M1: cumulative allocations, not just the final DOM size. Failed
+ * admissions never recurse or allocate, including malformed-tree reparenting. */
+static bool ciuki_take(dom_hubbub_parser *p, size_t bytes)
+{
+    if (p->ciuki_rejected || p->ciuki_nodes >= 8192 || bytes > 8192 ||
+        bytes > 131072 - p->ciuki_text) {
+        p->ciuki_rejected = true;
+        fprintf(stderr, "NetSurf structure rejected: parser admission limit.\n");
+        return false;
+    }
+    p->ciuki_nodes++;
+    p->ciuki_text += bytes;
+    return true;
+}
+static bool ciuki_attach(void *parent, void *child)
+{
+    dom_node_internal *p = parent, *root = child, *node = child;
+    unsigned depth = 0, seen = 0;
+    for (; p; p = p->parent) if (++depth >= 64) return false;
+    unsigned at = depth + 1;
+    while (node) {
+        if (at > 64 || ++seen > 8192) return false;
+        if (node->first_child) { node = node->first_child; at++; continue; }
+        while (node != root && !node->next) { node = node->parent; at--; }
+        if (node == root) break;
+        node = node->next;
+    }
+    return true;
+}
 
