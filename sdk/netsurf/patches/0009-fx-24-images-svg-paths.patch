--- a/netsurf/content/handlers/image/jpeg.c
+++ b/netsurf/content/handlers/image/jpeg.c
@@ -332,6 +332,23 @@
 	}
 	cinfo.dct_method = JDCT_ISLOW;
 
+#ifdef CIUKI_NETSURF
+	/* fx-24: a photograph larger than the framebuffer bitmap admission
+	 * (1024x1024 pixels, 4096 per side; framebuffer/bitmap.c) is decoded in
+	 * the DCT domain at 1/2, 1/4 or 1/8 (libjpeg scale_denom) instead of
+	 * being refused; the plotter scales the bitmap to the box as for any
+	 * image, and the content keeps its intrinsic size for layout. */
+	cinfo.scale_num = 1;
+	cinfo.scale_denom = 1;
+	for (;;) {
+		size_t w = (cinfo.image_width + cinfo.scale_denom - 1) / cinfo.scale_denom;
+		size_t h = (cinfo.image_height + cinfo.scale_denom - 1) / cinfo.scale_denom;
+		if (cinfo.scale_denom >= 8 || (w <= 4096 && h <= 4096 && w * h <= 1024u * 1024u))
+			break;
+		cinfo.scale_denom *= 2;
+	}
+#endif
+
 	/* commence the decompression, output parameters now valid */
 	jpeg_start_decompress(&cinfo);
 
