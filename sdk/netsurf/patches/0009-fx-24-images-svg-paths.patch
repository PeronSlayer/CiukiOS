CiukiOS fx-24: images and SVG as upstream framebuffer NetSurf shows them.
framebuffer.c: path plotter hook (upstream leaves paths unimplemented) and
clip rectangles outside the surface as empty clips (the error reached the
next knockout flush and drew broken objects); Makefile: port files path.c,
heap.c; jpeg.c: DCT-scaled decode above the bitmap admission; libsvgtiny:
missing width/height from the viewBox aspect ratio; redraw.c: sizeof of a
pointer; netsurf.c: bitmap cache from the image ledger; browser_history.c:
no unused local-history thumbnails. Evidence: build/codex/fx-24-report.md,
docs/design/netsurf-port-plan.md (fx-24 section).

--- a/libsvgtiny/src/svgtiny.c
+++ b/libsvgtiny/src/svgtiny.c
@@ -706,6 +706,44 @@
 #undef SVGTINY_STRING_ACTION2
 
 	svgtiny_parse_position_attributes(svg, state, &x, &y, &width, &height);
+	{
+		/* CiukiOS fx-24: an outermost <svg> without width and/or height
+		 * attributes takes the missing size from its viewBox aspect
+		 * ratio (SVG 1.1, 7.7 'viewBox'). NetSurf reformats an image with
+		 * a 0x0 viewport before layout and a block-level one with
+		 * width x 1 (layout_block_object): the viewport alone made such
+		 * an SVG 0 or 1 pixel high, then stretched it at redraw. With no
+		 * usable viewport either, the viewBox size is the intrinsic size. */
+		dom_string *w_attr = NULL, *h_attr = NULL, *vb_attr = NULL;
+		float min_x, min_y, vb_width = 0, vb_height = 0;
+		if (dom_element_get_attribute(svg, state.interned_width, &w_attr) != DOM_NO_ERR) w_attr = NULL;
+		if (dom_element_get_attribute(svg, state.interned_height, &h_attr) != DOM_NO_ERR) h_attr = NULL;
+		if (dom_element_get_attribute(svg, state.interned_viewBox, &vb_attr) != DOM_NO_ERR) vb_attr = NULL;
+		if (vb_attr != NULL && (w_attr == NULL || h_attr == NULL)) {
+			char *s = strndup(dom_string_data(vb_attr), dom_string_byte_length(vb_attr));
+			if (s != NULL && (sscanf(s, "%f,%f,%f,%f", &min_x, &min_y, &vb_width, &vb_height) == 4 ||
+					sscanf(s, "%f %f %f %f", &min_x, &min_y, &vb_width, &vb_height) == 4) &&
+					vb_width > 0 && vb_height > 0) {
+				if (w_attr == NULL && h_attr == NULL) {
+					if (viewport_width > 1) {
+						width = viewport_width;
+						height = viewport_height > 1 ? viewport_height : width * vb_height / vb_width;
+					} else {
+						width = vb_width;
+						height = vb_height;
+					}
+				} else if (h_attr == NULL) {
+					height = width * vb_height / vb_width;
+				} else {
+					width = height * vb_width / vb_height;
+				}
+			}
+			free(s);
+		}
+		if (w_attr != NULL) dom_string_unref(w_attr);
+		if (h_attr != NULL) dom_string_unref(h_attr);
+		if (vb_attr != NULL) dom_string_unref(vb_attr);
+	}
 	diagram->width = width;
 	diagram->height = height;
 
