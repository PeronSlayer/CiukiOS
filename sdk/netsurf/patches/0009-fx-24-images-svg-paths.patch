+#ifdef CIUKI_NETSURF
+	/* fx-24: decoded bitmaps are charged to the browser's image ledger
+	 * (sdk/netsurf/port/image_memory.h: an eighth of free memory, 2-16 MiB).
+	 * Size the bitmap cache from that ledger, three quarters of it, rather
+	 * than a quarter of the 2 MiB source cache: with 512 KiB the cleaner
+	 * dropped every off-screen bitmap of a page with a few photographs and
+	 * scrolling back decoded them again. The llcache keeps the whole
+	 * memory_cache_size for source data. */
+	image_cache_parameters.limit = ciuki_image_limit() / 4 * 3;
+	image_cache_parameters.hysteresis = image_cache_parameters.limit / 5;
+#else
