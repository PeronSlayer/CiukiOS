+size_t css__custom_memory_limit(void)
+{
+	if (!custom_limit_set) {
+#ifdef CIUKI_NETSURF
+		/* The existing free-memory query: no changes to DOM/box limits. */
+		custom_limit = ciuki_docmem_query() / 8;
+#else
+		custom_limit = 7u * 1024u * 1024u; /* standalone host library model */
+#endif
+		custom_limit_set = true;
+	}
