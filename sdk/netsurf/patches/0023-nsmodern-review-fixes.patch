+size_t css__custom_memory_used(void) { return custom_bytes; }
+bool css__custom_reserve(size_t bytes)
+{
+	if (bytes > css__custom_memory_limit() - custom_bytes) return false;
+	custom_bytes += bytes;
+	return true;
+}
+void css__custom_release(size_t bytes) { custom_bytes -= bytes; }
+
+/* Count allocator/header overhead too; failed growth preserves the old charge. */
+union custom_header { size_t bytes; long double alignment; void *pointer; };
+void *css__custom_realloc(void *ptr, size_t bytes)
+{
+	union custom_header *old = ptr != NULL ? (union custom_header *)ptr - 1 : NULL;
+	size_t previous = old != NULL ? old->bytes : 0;
+	if (bytes > SIZE_MAX - sizeof(*old)) return NULL;
+	bytes += sizeof(*old);
+	if (bytes > previous && !css__custom_reserve(bytes - previous)) return NULL;
+	union custom_header *allocation = realloc(old, bytes);
+	if (allocation == NULL) {
+		if (bytes > previous) css__custom_release(bytes - previous);
+		return NULL;
+	}
+	if (previous > bytes) css__custom_release(previous - bytes);
+	allocation->bytes = bytes;
+	return allocation + 1;
+}
+void css__custom_free(void *ptr)
+{
+	if (ptr == NULL) return;
+	union custom_header *header = (union custom_header *)ptr - 1;
+	css__custom_release(header->bytes);
+	free(header);
+}
+void css__custom_features_changed(void)
+{
+	/* On saturation caching is disabled rather than accepting a stale epoch. */
+	if (feature_epoch != UINT64_MAX) feature_epoch++;
+}
+uint64_t css__custom_features_epoch(void) { return feature_epoch; }
+void css__custom_sheet_changed(css_stylesheet *sheet)
