+/**
+ * Ciuki t23-render: give a box the image the parser already fetched.
+ *
+ * html_process_inserted_img (dom_event.c) fetches an img element's image
+ * while the document is parsed, without a box; box construction then asked
+ * for the same URL again. When that first fetch had completed and its object
+ * was not reusable by the low-level cache (llcache keeps no response to a
+ * URL with a query unless it carries an explicit expiry, as encyclopedia
+ * thumbnails do), every image was downloaded and decoded twice: 18 of the
+ * 49 fetches of the T23 trial c42f556e. The HTML Standard's list of
+ * available images reuses an image already obtained for the document.
+ *
+ * \return true when an object without a box was adopted for this box
+ */
+static bool
+html_adopt_speculative_object(html_content *c,
+			      nsurl *url,
+			      struct box *box,
+			      content_type permitted_types,
+			      bool background)
+{
+	struct content_html_object *object;
+
+	if (box == NULL || background)
+		return false;
+
+	for (object = c->object_list; object != NULL; object = object->next) {
+		struct content *content;
+		nsurl *fetched;
+
+		if (object->box != NULL || object->content == NULL ||
+		    object->background ||
+		    object->permitted_types != permitted_types)
+			continue;
+
+		fetched = hlcache_handle_get_url(object->content);
+		if (fetched == NULL ||
+		    nsurl_compare(fetched, url, NSURL_COMPLETE) == false)
+			continue;
+
+		content = hlcache_handle_get_content(object->content);
+		if (content != NULL && content->status == CONTENT_STATUS_ERROR)
+			continue;
+
+		object->box = box;
+		hlcache_handle_replace_callback(object->content,
+				html_object_callback, object);
+
+		if (content != NULL &&
+		    (content->status == CONTENT_STATUS_READY ||
+		     content->status == CONTENT_STATUS_DONE) &&
+		    content_can_reformat(object->content)) {
+			/* Content that can reformat (SVG) gets its size in the
+			 * READY step, from the laid-out box; a fetch completing
+			 * after box construction delivers READY and DONE after
+			 * the first layout. Replay them then
+			 * (html_object_ciuki_replay); until DONE it counts as an
+			 * active fetch. */
+			object->ciuki_replay_ready = true;
+			object->ciuki_replay_done =
+				content->status == CONTENT_STATUS_DONE;
+		} else if (content != NULL &&
+			   (content->status == CONTENT_STATUS_READY ||
+			    content->status == CONTENT_STATUS_DONE)) {
+			/* A raster image has its size already. */
+			html_object_done(box, object->content, false);
+		}
+		if (content == NULL || content->status != CONTENT_STATUS_DONE ||
+		    object->ciuki_replay_done) {
+			/* LOADING, READY, not yet created or replayed: DONE or
+			 * ERROR ends the active fetch. */
+			c->base.active++;
+			NSLOG(netsurf, INFO, "%d fetches active",
+			      c->base.active);
+		}
+		ciuki_speculative_adoptions++;
+		return true;
+	}
+
+	return false;
+}
+
+/* exported interface documented in html/object.h */
+void html_object_ciuki_replay(html_content *c)
+{
+	struct content_html_object *object, *next;
+
+	for (object = c->object_list; object != NULL; object = next) {
+		hlcache_event event = { .type = CONTENT_MSG_READY };
+		bool ready = object->ciuki_replay_ready;
+		bool done = object->ciuki_replay_done;
+
+		/* The callbacks may reformat or finish the document but do
+		 * not change its object list. */
+		next = object->next;
+		object->ciuki_replay_ready = object->ciuki_replay_done = false;
+		if (object->content == NULL || object->box == NULL)
+			continue;
+		if (ready)
+			html_object_callback(object->content, &event, object);
+		if (done && object->content != NULL) {
+			event.type = CONTENT_MSG_DONE;
+			html_object_callback(object->content, &event, object);
+		}
+	}
+}
