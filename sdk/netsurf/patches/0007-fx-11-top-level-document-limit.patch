CiukiOS fx-11 (lead decision 2026-10-23): the document of a top-level browser
window gets a 10 s layout limit (CIUKI_LAYOUT_DOCUMENT_LIMIT_NS, budget.h);
frames, iframes, embedded objects and every other remote span keep 75 ms. The
first layout runs from browser_window_content_ready before content_open gives
the content its window, so browser_window.c flags top-level reformats
(ciuki_layout_top_level); later reflows (objects arriving) match the root
window's current content. Evidence: docs/validation/fx-11-netsurf-fetch-layout.md.

--- a/netsurf/content/handlers/html/layout.c
+++ b/netsurf/content/handlers/html/layout.c
@@ -5510,15 +5510,27 @@
 }
 
 #include "framebuffer/ciuki/font_work.h"
+#include "content/hlcache.h"
+#include "desktop/browser_private.h"
+
+/* fx-11 (lead decision 2026-10-23): the current document of a top-level
+ * browser window. browser_window.c flags the first layout, which runs before
+ * content_open sets htmlc->bw; frames, iframes and objects never match. */
+static bool ciuki_layout_document_window(struct content *c, struct browser_window *bw)
+{
+    return ciuki_layout_top_level || (bw && !bw->parent && bw->current_content &&
+                                      hlcache_handle_get_content(bw->current_content) == c);
+}
 
