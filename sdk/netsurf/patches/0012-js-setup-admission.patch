+/* CiukiOS: Duktape allocations are admitted against the JavaScript budget
+ * (js_memory.c, an eighth of free memory), so heap and thread setup can fail
+ * an allocation. Upstream runs that setup without a catchpoint: the error
+ * reached Duktape's default fatal handler (abort) or, when even the
+ * uncaught-error text could not be allocated, recursed until the stack
+ * overflowed. Heap creation itself has no catchpoint inside Duktape, so a
+ * heap is only made with CIUKI_JS_HEAP_MIN of budget left; the generated
+ * dukky_create_prototypes() skips a prototype whose allocation failed (a
+ * missing Window prototype then made the window an HTMLUnknownElement over
+ * the browser_window pointer), so any refused allocation during setup
+ * discards the heap. Each step runs under duk_safe_call; a window whose heap
+ * cannot be made has no scripting (as with the "none" backend: NULL heap,
+ * NULL thread) instead of no window, and a document whose thread could not
+ * be made is not retried at each inserted element. */
+#define CIUKI_JS_HEAP_MIN (1024u * 1024u)
+static void dukky_ciuki_unavailable(const char *what, size_t charged)
+{
+	char line[128];
+	int n = snprintf(line, sizeof(line),
+		"NetSurf JavaScript unavailable: %s (charged %zu bytes)\n",
+		what, charged);
+	if (n > 0) fwrite(line, 1, (size_t)n < sizeof(line) ? (size_t)n : sizeof(line) - 1, stderr);
+}
+static duk_ret_t dukky_ciuki_heap_setup(duk_context *ctx, void *udata)
+{
+	(void)udata;
+	duk_push_global_object(ctx);
+	duk_push_boolean(ctx, true);
+	duk_put_prop_string(ctx, -2, "protos");
+	duk_put_global_string(ctx, PROTO_MAGIC);
+	dukky_create_prototypes(ctx);
+	duk_push_object(ctx);
+	duk_put_global_string(ctx, THREAD_MAP);
+	return 0;
+}
+#endif
