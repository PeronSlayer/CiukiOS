-				ret = utf8_convert_html_chunk(cd, in, inlen,
-							      &out, &outlen);
-				if (ret != NSERROR_OK) {
-					free(origout);
-					iconv_close(cd);
-					utf8_clear_cd_cache();
-					return ret;
-				}
-			}
-
-			/* Emit mandatory escape */
-			esclen = snprintf(escape, sizeof(escape),
