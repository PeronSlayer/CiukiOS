CiukiOS M2: register the native HTTP/HTTPS fetcher, compile its port-owned
engine, bridge fd sets through native poll on every <=10 ms UI turn, and enforce
the approved five redirect hops with 307/308 method preservation. Native inet
headers replace the M1 local-only address declarations. file: and data: unchanged.

--- a/netsurf/content/fetch.c
+++ b/netsurf/content/fetch.c
@@ -52,6 +52,7 @@
 
 #include "content/fetch.h"
 #include "content/fetchers.h"
+#include "framebuffer/ciuki/fetch_ciuki.h"
 #include "content/fetchers/resource.h"
 #include "content/fetchers/about/about.h"
 #ifdef WITH_CURL
@@ -287,6 +288,9 @@
 nserror fetcher_init(void)
 {
 	nserror ret;
+
+	ret = fetch_ciuki_register();
+	if (ret != NSERROR_OK) return ret;
 
 #ifdef WITH_CURL
 	ret = fetch_curl_register();
