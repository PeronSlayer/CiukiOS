+} css_custom_tokens;
+
+typedef struct css_custom_decl {
+	lwc_string *name;
+	css_custom_tokens *tokens;
+	int handler; /* -1 custom; -2/-3 gap; otherwise property_handlers index */
+	bool important;
+	unsigned next; /* index + 1 within the containing sheet */
+} css_custom_decl;
+
+typedef struct css_custom_gap {
+	css_fixed row, column;
+	uint32_t row_unit, column_unit;
+	enum flag_value flag;
+	bool normal;
+} css_custom_gap;
+css_error css__custom_gap_parse(css_language *c, const css_custom_tokens *tokens,
+		int handler, css_custom_gap *gap);
+
+bool css__custom_name(lwc_string *name);
+bool css__custom_ident(const css_token *token, const char *name);
+css_error css__custom_tokens_create(css_custom_tokens **tokens);
+css_error css__custom_tokens_append(css_custom_tokens *tokens, const css_token *token);
+css_custom_tokens *css__custom_tokens_ref(css_custom_tokens *tokens);
+void css__custom_tokens_unref(css_custom_tokens *tokens);
+void css__custom_sheet_destroy(css_stylesheet *sheet);
+css_error css__custom_parse(css_language *c, const css_token *property,
+		const parserutils_vector *vector, int32_t *ctx, css_rule *rule,
+		int handler, bool *handled);
+/* Validates and locates the name, optional fallback and matching ')'. */
+css_error css__custom_var(const parserutils_vector *v, int32_t start,
+		int32_t *name, int32_t *fallback, int32_t *end);
+#endif
