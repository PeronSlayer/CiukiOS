+/* CiukiOS: deferred token values, not textual stylesheet replacement.
+ * MIT; see the libcss licence. */
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include "parse/custom.h"
+#include "parse/properties/utils.h"
+
+bool css__custom_name(lwc_string *name)
+{
+	return name != NULL && lwc_string_length(name) > 2 &&
+		memcmp(lwc_string_data(name), "--", 2) == 0;
+}
+
+bool css__custom_ident(const css_token *token, const char *name)
+{
+	return token != NULL && token->idata != NULL &&
+		lwc_string_length(token->idata) == strlen(name) &&
+		strncasecmp(lwc_string_data(token->idata), name, strlen(name)) == 0;
+}
+
+css_error css__custom_tokens_create(css_custom_tokens **out)
+{
+	css_custom_tokens *t = calloc(1, sizeof(*t));
+	if (t == NULL) return CSS_NOMEM;
+	if (parserutils_vector_create(sizeof(css_token), 8, &t->vector) != PARSERUTILS_OK) {
+		free(t);
+		return CSS_NOMEM;
+	}
+	t->refs = 1;
+	*out = t;
+	return CSS_OK;
+}
+
+css_error css__custom_tokens_append(css_custom_tokens *t, const css_token *token)
+{
+	css_token copy = *token;
+	if (t->count == CSS_CUSTOM_TOKEN_LIMIT) return CSS_INVALID;
+	/* Lexer data is borrowed; only the interned string survives parsing. */
+	if (copy.idata != NULL) {
+		copy.data.data = (uint8_t *)lwc_string_data(copy.idata);
+		copy.data.len = lwc_string_length(copy.idata);
+	} else {
+		copy.data.data = (uint8_t *)" ";
+		copy.data.len = 1;
+	}
+	if (parserutils_vector_append(t->vector, &copy) != PARSERUTILS_OK)
+		return CSS_NOMEM;
+	if (copy.idata != NULL) lwc_string_ref(copy.idata);
+	t->count++;
+	return CSS_OK;
+}
+
+css_custom_tokens *css__custom_tokens_ref(css_custom_tokens *t)
+{
+	if (t != NULL) t->refs++;
+	return t;
+}
+
+void css__custom_tokens_unref(css_custom_tokens *t)
+{
+	if (t == NULL || --t->refs != 0) return;
+	int32_t i = 0;
+	const css_token *token;
+	while ((token = parserutils_vector_iterate(t->vector, &i)) != NULL)
+		if (token->idata != NULL) lwc_string_unref(token->idata);
+	parserutils_vector_destroy(t->vector);
+	free(t);
+}
+
+void css__custom_sheet_destroy(css_stylesheet *sheet)
+{
+	for (unsigned i = 0; i < sheet->custom_count; i++) {
+		lwc_string_unref(sheet->custom[i].name);
+		css__custom_tokens_unref(sheet->custom[i].tokens);
+	}
+	free(sheet->custom);
+}
+
+css_error css__custom_var(const parserutils_vector *v, int32_t start,
+		int32_t *name, int32_t *fallback, int32_t *end)
+{
+	int32_t i = start + 1;
+	const css_token *t;
+	consumeWhitespace(v, &i);
+	*name = i;
+	t = parserutils_vector_iterate(v, &i);
+	if (t == NULL || t->type != CSS_TOKEN_IDENT || !css__custom_name(t->idata))
+		return CSS_INVALID;
+	consumeWhitespace(v, &i);
+	t = parserutils_vector_peek(v, i);
+	*fallback = -1;
+	if (tokenIsChar(t, ',')) *fallback = ++i;
+	else if (!tokenIsChar(t, ')')) return CSS_INVALID;
+	unsigned depth = 0;
+	for (; (t = parserutils_vector_peek(v, i)) != NULL; i++) {
+		if (t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '(') ||
+				tokenIsChar(t, '[') || tokenIsChar(t, '{')) {
+			if (++depth > CSS_CUSTOM_DEPTH) return CSS_INVALID;
+		} else if (tokenIsChar(t, ')') || tokenIsChar(t, ']') || tokenIsChar(t, '}')) {
+			if (depth == 0) {
+				if (!tokenIsChar(t, ')')) return CSS_INVALID;
+				*end = i;
+				return CSS_OK;
+			}
+			depth--;
+		}
+	}
+	return CSS_INVALID;
+}
+
+css_error css__custom_parse(css_language *c, const css_token *property,
+		const parserutils_vector *v, int32_t *ctx, css_rule *rule,
+		int handler, bool *handled)
+{
+	bool custom = css__custom_name(property->idata), var = false;
+	bool gap = css__custom_ident(property, "gap") || css__custom_ident(property, "row-gap");
+	if (gap) handler = css__custom_ident(property, "gap") ? CSS_CUSTOM_GAP : CSS_CUSTOM_ROW_GAP;
+	int32_t begin = *ctx, end = begin, bang = -1;
+	const css_token *t;
+	char stack[CSS_CUSTOM_DEPTH];
+	unsigned depth = 0;
+	*handled = false;
+	for (; (t = parserutils_vector_peek(v, end)) != NULL; end++) {
+		if (t->type == CSS_TOKEN_FUNCTION && css__custom_ident(t, "var")) var = true;
+	}
+	if (!custom && !var && !gap) return CSS_OK;
+	*handled = true;
+	if (handler < 0 && !custom && !gap) return CSS_INVALID;
+	/* Validate balanced component values and !important outside blocks. */
+	for (int32_t i = begin; i < end; i++) {
+		t = parserutils_vector_peek(v, i);
+		if (t->type == CSS_TOKEN_INVALID_STRING) return CSS_INVALID;
+		if (t->type == CSS_TOKEN_FUNCTION || tokenIsChar(t, '(') ||
+				tokenIsChar(t, '[') || tokenIsChar(t, '{')) {
+			if (depth == CSS_CUSTOM_DEPTH) return CSS_INVALID;
+			stack[depth++] = tokenIsChar(t, '[') ? ']' : tokenIsChar(t, '{') ? '}' : ')';
+		} else if (tokenIsChar(t, ')') || tokenIsChar(t, ']') || tokenIsChar(t, '}')) {
+			if (depth == 0 || !tokenIsChar(t, stack[--depth])) return CSS_INVALID;
+		} else if (depth == 0 && (tokenIsChar(t, '!') || tokenIsChar(t, ';'))) {
+			if (tokenIsChar(t, ';') || bang >= 0) return CSS_INVALID;
+			bang = i;
+		}
+		if (t->type == CSS_TOKEN_FUNCTION && css__custom_ident(t, "var")) {
+			int32_t name, fallback, close;
+			if (css__custom_var(v, i, &name, &fallback, &close) != CSS_OK) return CSS_INVALID;
+		}
+	}
+	if (depth != 0) return CSS_INVALID;
+	if (bang >= 0) {
+		int32_t i = bang + 1;
+		consumeWhitespace(v, &i);
+		t = parserutils_vector_iterate(v, &i);
+		if (t == NULL || t->type != CSS_TOKEN_IDENT || !css__custom_ident(t, "important"))
+			return CSS_INVALID;
+		consumeWhitespace(v, &i);
+		if (i != end) return CSS_INVALID;
+		end = bang;
+	}
+	while (begin < end && ((const css_token *)parserutils_vector_peek(v, begin))->type == CSS_TOKEN_S) begin++;
+	while (end > begin && ((const css_token *)parserutils_vector_peek(v, end - 1))->type == CSS_TOKEN_S) end--;
+	if (end - begin > CSS_CUSTOM_TOKEN_LIMIT || c->sheet->custom_count == CSS_CUSTOM_DECL_LIMIT ||
+			c->sheet->custom_tokens + (unsigned)(end - begin) > CSS_CUSTOM_SHEET_TOKENS)
+		return CSS_NOMEM; /* bounded sheet admission, never silently mis-cascade */
+	css_custom_tokens *tokens;
+	css_error error = css__custom_tokens_create(&tokens);
+	if (error != CSS_OK) return error;
+	for (int32_t i = begin; i < end; i++) {
+		css_token copy = *(const css_token *)parserutils_vector_peek(v, i);
+		/* Variables 1 section 2.1: URLs resolve in the consuming sheet. */
+		error = css__custom_tokens_append(tokens, &copy);
+		if (error != CSS_OK) break;
+	}
+	if (error == CSS_OK && gap && !var) {
+		css_custom_gap parsed;
+		error = css__custom_gap_parse(c, tokens, handler, &parsed);
+	}
+	css_style *style = NULL;
+	if (error == CSS_OK) error = css__stylesheet_style_create(c->sheet, &style);
+	if (error == CSS_OK) error = css__stylesheet_style_vappend(style, 2,
+			buildOPV((opcode_t)CSS_CUSTOM_OPCODE, bang >= 0 ? FLAG_IMPORTANT : 0, 0), c->sheet->custom_count);
+	if (error == CSS_OK) {
+		css_custom_decl *decls = realloc(c->sheet->custom,
+				(c->sheet->custom_count + 1) * sizeof(*decls));
+		if (decls == NULL) error = CSS_NOMEM;
+		else c->sheet->custom = decls;
+	}
+	if (error == CSS_OK) {
+		css_custom_decl *d = &c->sheet->custom[c->sheet->custom_count++];
+		*d = (css_custom_decl){ lwc_string_ref(property->idata), tokens, custom ? -1 : handler, bang >= 0, 0 };
+		style->custom_first = style->custom_last = c->sheet->custom_count;
+		c->sheet->custom_tokens += tokens->count;
+		c->sheet->size += sizeof(*d) + tokens->count * sizeof(css_token);
+		tokens = NULL;
+		error = css__stylesheet_rule_append_style(c->sheet, rule, style);
+		if (error == CSS_OK) style = NULL;
+	}
+	if (style != NULL) css__stylesheet_style_destroy(style);
+	css__custom_tokens_unref(tokens);
+	return error;
+}
+
+css_error css__custom_gap_parse(css_language *c, const css_custom_tokens *tokens,
+		int handler, css_custom_gap *gap)
+{
+	int32_t ctx = 0;
+	consumeWhitespace(tokens->vector, &ctx);
+	const css_token *t = parserutils_vector_peek(tokens->vector, ctx);
+	css_fixed row = 0, column = 0;
+	uint32_t row_unit = UNIT_PX, column_unit = UNIT_PX;
+	enum flag_value flag = t != NULL ? get_css_flag_value(c, t) : FLAG_VALUE__NONE;
+	bool normal = t != NULL && t->type == CSS_TOKEN_IDENT && css__custom_ident(t, "normal");
+	if (flag != FLAG_VALUE__NONE || normal) {
+		parserutils_vector_iterate(tokens->vector, &ctx);
+	} else {
+		css_error error = css__parse_unit_specifier(c, tokens->vector, &ctx, UNIT_PX, &row, &row_unit);
+		if (error != CSS_OK) return error;
+		if (row < 0 || !(row_unit & (UNIT_LENGTH | UNIT_PCT))) return CSS_INVALID;
+		column = row;
+		column_unit = row_unit;
+		consumeWhitespace(tokens->vector, &ctx);
+		if (handler == CSS_CUSTOM_GAP && parserutils_vector_peek(tokens->vector, ctx) != NULL) {
+			error = css__parse_unit_specifier(c, tokens->vector, &ctx, UNIT_PX, &column, &column_unit);
+			if (error != CSS_OK) return error;
+			if (column < 0 || !(column_unit & (UNIT_LENGTH | UNIT_PCT))) return CSS_INVALID;
+		}
+	}
+	consumeWhitespace(tokens->vector, &ctx);
+	if (parserutils_vector_peek(tokens->vector, ctx) != NULL) return CSS_INVALID;
+	*gap = (css_custom_gap){ row, column, row_unit, column_unit, flag, normal };
+	return CSS_OK;
+}
+
