+/* CiukiOS: per-element custom-property cascade and computed token inheritance.
+ * MIT; see the libcss licence. No public libcss ABI is changed. */
+#include <stdlib.h>
+#include <string.h>
+#include "select/custom.h"
+#include "parse/properties/properties.h"
+#include "parse/important.h"
+#include "select/computed.h"
+#include "parse/properties/utils.h"
+#include "bytecode/opcodes.h"
+#include "select/properties/helpers.h"
+
+typedef struct custom_candidate {
+	css_custom_tokens *raw;
+	prop_state rank;
+} custom_candidate;
+
+typedef struct custom_entry {
+	lwc_string *name;
+	custom_candidate candidate[CSS_ORIGIN_AUTHOR + 1];
+	css_custom_tokens *raw;
+	css_custom_tokens *value;
+	unsigned visit;
+	unsigned resolving;
+	bool cycle;
+} custom_entry;
+
+struct css_custom_env {
+	unsigned refs, count;
+	struct css_custom_env *parent;
+	custom_entry *entries;
+};
+
+struct css_custom_match {
+	const css_style *style;
+	css_pseudo_element pseudo;
+	css_origin origin;
+	uint32_t specificity;
+};
+
+static struct css_custom_env *env_ref(struct css_custom_env *e)
+{
+	if (e != NULL) e->refs++;
+	return e;
+}
+
+void css__custom_env_unref(struct css_custom_env *e)
+{
+	/* Iterative release: nesting in the DOM must not grow the C stack. */
+	while (e != NULL && --e->refs == 0) {
+		struct css_custom_env *parent = e->parent;
+		for (unsigned i = 0; i < e->count; i++) {
+			custom_entry *entry = &e->entries[i];
+			lwc_string_unref(entry->name);
+			for (unsigned j = 0; j <= CSS_ORIGIN_AUTHOR; j++)
+				css__custom_tokens_unref(entry->candidate[j].raw);
+			css__custom_tokens_unref(entry->value);
+		}
+		free(e->entries);
+		free(e);
+		e = parent;
+	}
+}
+
+bool css__custom_sheet_uses(const css_stylesheet *sheet, unsigned depth)
+{
+	if (sheet->custom_count != 0 || depth == CSS_CUSTOM_DEPTH) return true;
+	for (css_rule *r = sheet->rule_list; r != NULL; r = r->next)
+		if (r->type == CSS_RULE_IMPORT) {
+			css_stylesheet *import = ((css_rule_import *)r)->sheet;
+			if (import != NULL && css__custom_sheet_uses(import, depth + 1)) return true;
+		}
+	return false;
+}
+
+static css_error work(css_select_state *state)
+{
+	if (state->custom_work == 0) return CSS_NOMEM;
+	state->custom_work--;
+	return CSS_OK;
+}
+
+static css_error find_local(css_select_state *state, struct css_custom_env *e,
+		lwc_string *name, custom_entry **entry)
+{
+	*entry = NULL;
+	if (e == NULL) return CSS_OK;
+	for (unsigned i = 0; i < e->count; i++) {
+		bool equal;
+		if (work(state) != CSS_OK) return CSS_NOMEM;
+		if (lwc_string_isequal(e->entries[i].name, name, &equal) == lwc_error_ok && equal) {
+			*entry = &e->entries[i];
+			break;
+		}
+	}
+	return CSS_OK;
+}
+
+static css_error find_inherited(css_select_state *state, struct css_custom_env *e,
+		lwc_string *name, css_custom_tokens **value)
+{
+	*value = NULL;
+	for (; e != NULL; e = e->parent) {
+		custom_entry *entry;
+		css_error error = find_local(state, e, name, &entry);
+		if (error != CSS_OK) return error;
+		if (entry != NULL) {
+			*value = entry->value;
+			break;
+		}
+	}
+	return CSS_OK;
+}
+
+css_error css__custom_begin(css_select_state *state, void *parent)
+{
+	state->custom_collect = true;
+	state->custom_work = CSS_CUSTOM_WORK_LIMIT;
+	if (parent != NULL) {
+		struct css_node_data *data = NULL;
+		css_error error = state->handler->get_libcss_node_data(state->pw, parent, (void **)&data);
+		if (error != CSS_OK) return error;
+		if (data != NULL) state->custom_parent = env_ref(data->custom[CSS_PSEUDO_ELEMENT_NONE]);
+	}
+	return CSS_OK;
+}
+
+css_error css__custom_collect(const css_style *style, css_select_state *state)
+{
+	if (style == NULL) return CSS_OK;
+	if (state->custom_matches == CSS_CUSTOM_MATCH_LIMIT) return CSS_NOMEM;
+	if (state->custom_matches == state->custom_allocated) {
+		unsigned capacity = state->custom_allocated ? state->custom_allocated * 2 : 16;
+		struct css_custom_match *matches = realloc(state->custom_match, capacity * sizeof(*matches));
+		if (matches == NULL) return CSS_NOMEM;
+		state->custom_match = matches;
+		state->custom_allocated = capacity;
+	}
+	state->custom_match[state->custom_matches++] = (struct css_custom_match){
+		style, state->current_pseudo, state->current_origin, state->current_specificity };
+	for (unsigned at = style->custom_first; at != 0; ) {
+		const css_custom_decl *decl = &style->sheet->custom[at - 1];
+		at = decl->next;
+		if (decl->handler != -1) continue;
+		struct css_custom_env **slot = &state->node_data->custom[state->current_pseudo];
+		if (*slot == NULL) {
+			*slot = calloc(1, sizeof(**slot));
+			if (*slot == NULL) return CSS_NOMEM;
+			(*slot)->refs = 1;
+		}
+		struct css_custom_env *e = *slot;
+		custom_entry *entry;
+		css_error error = find_local(state, e, decl->name, &entry);
+		if (error != CSS_OK) return error;
+		if (entry == NULL) {
+			if (e->count == CSS_CUSTOM_ENTRY_LIMIT) return CSS_NOMEM;
+			custom_entry *entries = realloc(e->entries, (e->count + 1) * sizeof(*entries));
+			if (entries == NULL) return CSS_NOMEM;
+			e->entries = entries;
+			entry = &entries[e->count++];
+			memset(entry, 0, sizeof(*entry));
+			entry->name = lwc_string_ref(decl->name);
+		}
+		custom_candidate *candidate = &entry->candidate[state->current_origin];
+		if (css__outranks_state(&candidate->rank, decl->important, state, FLAG_VALUE__NONE)) {
+			css__custom_tokens_unref(candidate->raw);
+			candidate->raw = css__custom_tokens_ref(decl->tokens);
+		}
+	}
+	return CSS_OK;
+}
+
+static bool keyword(css_custom_tokens *t, const char *word)
+{
+	const css_token *token = t != NULL ? parserutils_vector_peek(t->vector, 0) : NULL;
+	return t != NULL && t->count == 1 && token->type == CSS_TOKEN_IDENT &&
+		css__custom_ident(token, word);
+}
+
+static void choose_candidate(css_select_state *state, custom_entry *entry)
+{
+	int ceiling = CSS_ORIGIN_AUTHOR;
+	while (ceiling >= CSS_ORIGIN_UA) {
+		prop_state rank = {0};
+		custom_candidate *winner = NULL;
+		for (int origin = CSS_ORIGIN_UA; origin <= ceiling; origin++) {
+			custom_candidate *c = &entry->candidate[origin];
+			if (!c->rank.set) continue;
+			state->current_origin = origin;
+			state->current_specificity = c->rank.specificity;
+			if (css__outranks_state(&rank, c->rank.important, state, FLAG_VALUE__NONE)) winner = c;
+		}
+		if (winner == NULL) break;
+		if (keyword(winner->raw, "revert")) {
+			ceiling = (int)rank.origin - 1;
+			continue;
+		}
+		entry->raw = winner->raw;
+		break;
+	}
+}
+
+/* Dependency analysis includes unused fallbacks, as required by Variables 1.
+ * Mark only the cycle's members, so a dependent var(--cycle, red) can recover. */
+static css_error graph(css_select_state *state, struct css_custom_env *e,
+		custom_entry *entry, custom_entry **path, unsigned depth)
+{
+	if (entry->visit == 2) return CSS_OK;
+	if (entry->visit == 1) {
+		bool member = false;
+		for (unsigned i = 0; i < depth; i++) {
+			member |= path[i] == entry;
+			if (member) path[i]->cycle = true;
+		}
+		return CSS_OK;
+	}
+	if (depth == CSS_CUSTOM_DEPTH) return CSS_NOMEM;
+	entry->visit = 1;
+	path[depth++] = entry;
+	if (entry->raw != NULL) {
+		for (unsigned i = 0; i < entry->raw->count; i++) {
+			const css_token *t = parserutils_vector_peek(entry->raw->vector, i);
+			if (work(state) != CSS_OK) return CSS_NOMEM;
+			if (t->type == CSS_TOKEN_FUNCTION && css__custom_ident(t, "var")) {
+				int32_t name, fallback, end;
+				if (css__custom_var(entry->raw->vector, i, &name, &fallback, &end) != CSS_OK) return CSS_INVALID;
+				t = parserutils_vector_peek(entry->raw->vector, name);
+				custom_entry *target;
+				css_error error = find_local(state, e, t->idata, &target);
+				if (error != CSS_OK) return error;
+				if (target != NULL) {
+					error = graph(state, e, target, path, depth);
+					if (error != CSS_OK) return error;
+				}
+			}
+		}
+	}
+	entry->visit = 2;
+	return CSS_OK;
+}
+
+static css_error resolve_entry(css_select_state *, struct css_custom_env *, custom_entry *, unsigned);
+
+static css_error substitute(css_select_state *state, struct css_custom_env *e,
+		const parserutils_vector *v, int32_t begin, int32_t end,
+		css_custom_tokens *out, unsigned depth)
+{
+	if (depth == CSS_CUSTOM_DEPTH) return CSS_INVALID;
+	for (int32_t i = begin; i < end; i++) {
+		const css_token *t = parserutils_vector_peek(v, i);
+		if (work(state) != CSS_OK) return CSS_NOMEM;
+		css_error error;
+		if (t->type == CSS_TOKEN_FUNCTION && css__custom_ident(t, "var")) {
+			int32_t name, fallback, close;
+			error = css__custom_var(v, i, &name, &fallback, &close);
+			if (error != CSS_OK) return error;
+			t = parserutils_vector_peek(v, name);
+			custom_entry *entry;
+			css_custom_tokens *value = NULL;
+			error = find_local(state, e, t->idata, &entry);
+			if (error != CSS_OK) return error;
+			if (entry != NULL) {
+				error = resolve_entry(state, e, entry, depth + 1);
+				if (error != CSS_OK) return error;
+				value = entry->value;
+			} else {
+				error = find_inherited(state, e != NULL ? e->parent : NULL, t->idata, &value);
+				if (error != CSS_OK) return error;
+			}
+			if (value != NULL) {
+				for (unsigned j = 0; j < value->count; j++) {
+					if (work(state) != CSS_OK) return CSS_NOMEM;
+					error = css__custom_tokens_append(out, parserutils_vector_peek(value->vector, j));
+					if (error != CSS_OK) return error;
+				}
+			} else if (fallback >= 0) {
+				error = substitute(state, e, v, fallback, close, out, depth + 1);
+				if (error != CSS_OK) return error;
+			} else return CSS_INVALID;
+			i = close;
+		} else {
+			error = css__custom_tokens_append(out, t);
+			if (error != CSS_OK) return error;
+		}
+	}
+	return CSS_OK;
+}
+
+static css_error resolve_entry(css_select_state *state, struct css_custom_env *e,
+		custom_entry *entry, unsigned depth)
+{
+	if (entry->resolving == 2) return CSS_OK;
+	if (entry->cycle || entry->resolving == 1 || depth == CSS_CUSTOM_DEPTH) {
+		entry->resolving = 2;
+		return CSS_OK;
+	}
+	entry->resolving = 1;
+	css_error error = CSS_OK;
+	if (entry->raw == NULL || keyword(entry->raw, "inherit") || keyword(entry->raw, "unset")) {
+		css_custom_tokens *value;
+		error = find_inherited(state, e->parent, entry->name, &value);
+		if (error == CSS_OK) entry->value = css__custom_tokens_ref(value);
+	} else if (!keyword(entry->raw, "initial")) {
+		error = css__custom_tokens_create(&entry->value);
+		if (error == CSS_OK) error = substitute(state, e, entry->raw->vector, 0,
+				entry->raw->count, entry->value, depth + 1);
+		if (error != CSS_OK) {
+			css__custom_tokens_unref(entry->value);
+			entry->value = NULL;
+			if (error == CSS_INVALID) error = CSS_OK;
+		}
+	}
+	entry->resolving = 2;
+	return error;
+}
+
+static css_error resolve_env(css_select_state *state, struct css_custom_env **slot,
+		struct css_custom_env *parent)
+{
+	struct css_custom_env *e = *slot;
+	if (e == NULL) {
+		*slot = env_ref(parent);
+		return CSS_OK;
+	}
+	e->parent = env_ref(parent);
+	for (unsigned i = 0; i < e->count; i++) choose_candidate(state, &e->entries[i]);
+	custom_entry *path[CSS_CUSTOM_DEPTH];
+	for (unsigned i = 0; i < e->count; i++) {
+		css_error error = graph(state, e, &e->entries[i], path, 0);
+		if (error != CSS_OK) return error;
+	}
+	for (unsigned i = 0; i < e->count; i++) {
+		css_error error = resolve_entry(state, e, &e->entries[i], 0);
+		if (error != CSS_OK) return error;
+		/* Keep only computed tokens in the inherited environment. */
+	}
+	for (unsigned i = 0; i < e->count; i++) {
+		custom_entry *entry = &e->entries[i];
+		for (unsigned j = 0; j <= CSS_ORIGIN_AUTHOR; j++) {
+			css__custom_tokens_unref(entry->candidate[j].raw);
+			entry->candidate[j].raw = NULL;
+		}
+		entry->raw = NULL;
+	}
+	return CSS_OK;
+}
+
+css_error css__custom_finish(css_select_state *state)
+{
+	css_error error = resolve_env(state, &state->node_data->custom[0], state->custom_parent);
+	if (error != CSS_OK) return error;
+	for (unsigned i = 1; i < CSS_PSEUDO_ELEMENT_COUNT; i++) {
+		error = resolve_env(state, &state->node_data->custom[i], state->node_data->custom[0]);
+		if (error != CSS_OK) return error;
+	}
+	state->custom_collect = false;
+	css_origin origin = CSS_ORIGIN_UA;
+	for (unsigned i = 0; i < state->custom_matches; i++) {
+		struct css_custom_match *match = &state->custom_match[i];
+		if (state->revert != NULL && match->origin != origin) {
+			for (unsigned j = 0; j < CSS_PSEUDO_ELEMENT_COUNT; j++) {
+				if (state->results->styles[j] == NULL) continue;
+				css_computed_style_destroy(state->revert[origin].style[j]);
+				state->revert[origin].style[j] = NULL;
+				error = css__computed_style_clone(state->results->styles[j], &state->revert[origin].style[j]);
+				if (error != CSS_OK) return error;
+			}
+			memcpy(state->revert[origin].props, state->props, sizeof(state->props));
+			origin = match->origin;
+		}
+		state->current_pseudo = match->pseudo;
+		state->current_origin = match->origin;
+		state->current_specificity = match->specificity;
+		state->computed = state->results->styles[match->pseudo];
+		error = css__cascade_style(match->style, state);
+		if (error != CSS_OK) return error;
+	}
+	return CSS_OK;
+}
+
+void css__custom_cleanup(css_select_state *state)
+{
+	css__custom_env_unref(state->custom_parent);
+	free(state->custom_match);
+}
+
+void css__ciuki_computed_row_gap(const css_computed_style *style,
+		css_fixed *length, css_unit *unit)
+{
+	*length = style->i.ciuki_row_gap;
+	*unit = style->i.ciuki_row_gap_unit;
+}
+
+static css_error gap_style(css_language *c, const css_custom_tokens *tokens,
+		int handler, css_style *parsed, css_select_state *state, bool important)
+{
+	css_custom_gap gap;
+	css_error parse_error = css__custom_gap_parse(c, tokens, handler, &gap);
+	if (parse_error != CSS_OK) return parse_error;
+	css_fixed row = gap.row, column = gap.column;
+	uint32_t row_unit = gap.row_unit, column_unit = gap.column_unit;
+	enum flag_value flag = gap.flag;
+	if (handler == CSS_CUSTOM_GAP) {
+		css_error error = css__stylesheet_style_append(parsed,
+				buildOPV(CSS_PROP_COLUMN_GAP, flag << 1, gap.normal ? COLUMN_GAP_NORMAL : COLUMN_GAP_SET));
+		if (error != CSS_OK) return error;
+		if (flag == FLAG_VALUE__NONE && !gap.normal) {
+			error = css__stylesheet_style_vappend(parsed, 2, (css_code_t)column, column_unit);
+			if (error != CSS_OK) return error;
+		}
+	}
+	if (css__outranks_state(&state->custom_row_gap[state->current_pseudo], important, state, flag)) {
+		css_computed_style *result = state->computed;
+		result->i.ciuki_row_gap = row;
+		result->i.ciuki_row_gap_unit = css__to_css_unit(row_unit);
+		result->i.ciuki_row_gap_inherit = flag == FLAG_VALUE_INHERIT;
+		if (flag == FLAG_VALUE_REVERT && state->revert != NULL) {
+			for (int origin = (int)state->current_origin - 1; origin >= CSS_ORIGIN_UA; origin--) {
+				css_computed_style *earlier = state->revert[origin].style[state->current_pseudo];
+				if (earlier == NULL) continue;
+				result->i.ciuki_row_gap = earlier->i.ciuki_row_gap;
+				result->i.ciuki_row_gap_unit = earlier->i.ciuki_row_gap_unit;
+				result->i.ciuki_row_gap_inherit = earlier->i.ciuki_row_gap_inherit;
+				break;
+			}
+		}
+	}
+	return CSS_OK;
+}
+
+css_error css__custom_apply(const css_custom_decl *decl, css_select_state *state,
+		css_stylesheet *sheet)
+{
+	if (decl->handler == -1) return CSS_OK;
+	css_custom_tokens *tokens = NULL;
+	css_style *parsed = NULL;
+	css_language language = {0};
+	language.sheet = sheet;
+	css_error error = css__propstrings_get(&language.strings);
+	if (error != CSS_OK) return error;
+	error = css__custom_tokens_create(&tokens);
+	if (error != CSS_OK) goto done;
+	error = substitute(state, state->node_data->custom[state->current_pseudo],
+			decl->tokens->vector, 0, decl->tokens->count, tokens, 0);
+	if (error != CSS_OK && error != CSS_INVALID) goto done;
+	if (error == CSS_OK) {
+		int32_t ctx = 0;
+		consumeWhitespace(tokens->vector, &ctx);
+		error = css__stylesheet_style_create(sheet, &parsed);
+		if (error != CSS_OK) goto done;
+		error = decl->handler < -1 ?
+				gap_style(&language, tokens, decl->handler, parsed, state, decl->important) :
+				property_handlers[decl->handler](&language, tokens->vector, &ctx, parsed);
+		if (decl->handler < -1 && error == CSS_OK) ctx = tokens->count;
+		consumeWhitespace(tokens->vector, &ctx);
+		if (error == CSS_OK && parserutils_vector_peek(tokens->vector, ctx) != NULL) error = CSS_INVALID;
+	}
+	if (error == CSS_INVALID) {
+		/* A winning invalid value still participates in the cascade. */
+		if (parsed != NULL) css__stylesheet_style_destroy(parsed);
+		parsed = NULL;
+		css__custom_tokens_unref(tokens);
+		tokens = NULL;
+		error = css__custom_tokens_create(&tokens);
+		if (error != CSS_OK) goto done;
+		css_token unset = { .type = CSS_TOKEN_IDENT };
+		if (lwc_intern_string("unset", 5, &unset.idata) != lwc_error_ok) { error = CSS_NOMEM; goto done; }
+		error = css__custom_tokens_append(tokens, &unset);
+		lwc_string_unref(unset.idata);
+		if (error != CSS_OK) goto done;
+		error = css__stylesheet_style_create(sheet, &parsed);
+		if (error != CSS_OK) goto done;
+		int32_t ctx = 0;
+		error = decl->handler < -1 ?
+				gap_style(&language, tokens, decl->handler, parsed, state, decl->important) :
+				property_handlers[decl->handler](&language, tokens->vector, &ctx, parsed);
+		if (decl->handler < -1 && error == CSS_OK) ctx = tokens->count;
+	}
+	if (error == CSS_OK) {
+		if (decl->important) css__make_style_important(parsed);
+		error = css__cascade_style(parsed, state);
+	}
+ done:
+	if (parsed != NULL) css__stylesheet_style_destroy(parsed);
+	css__custom_tokens_unref(tokens);
+	css__propstrings_unref();
+	return error;
+}
