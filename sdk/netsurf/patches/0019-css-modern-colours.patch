+/* CiukiOS: Color 4 RGB has two separator grammars, sharing the same
+ * channel conversion. Clamp before scaling so even saturated input cannot
+ * overflow fixed-point arithmetic. No allocation or recursive parsing. */
+static css_error ciuki_rgb_component(const css_token *token, bool alpha,
+		bool allow_none, bool legacy, uint8_t *result)
+{
+	css_fixed number, maximum;
+	size_t consumed = 0;
+
+	if (token == NULL)
+		return CSS_INVALID;
+	if (allow_none && token->type == CSS_TOKEN_IDENT &&
+			lwc_string_length(token->idata) == 4 &&
+			strncasecmp(lwc_string_data(token->idata), "none", 4) == 0) {
+		*result = 0;
+		return CSS_OK;
+	}
+	if (token->type != CSS_TOKEN_NUMBER &&
+			token->type != CSS_TOKEN_PERCENTAGE)
+		return CSS_INVALID;
+	number = css__number_from_lwc_string(token->idata, false, &consumed);
+	if (consumed != lwc_string_length(token->idata))
+		return CSS_INVALID;
+	maximum = token->type == CSS_TOKEN_PERCENTAGE ? F_100 :
+			(alpha ? F_1 : F_255);
+	if (number <= 0)
+		*result = 0;
+	else if (number >= maximum)
+		*result = 255;
+	else
+		*result = ((int64_t)number * 255 + (legacy ? 0 : maximum / 2)) / maximum;
+	return CSS_OK;
+}
+
+static css_error ciuki_parse_rgb(const parserutils_vector *vector,
+		int32_t *ctx, uint8_t *r, uint8_t *g, uint8_t *b, uint8_t *a)
+{
+	uint8_t *channels[] = { r, g, b };
+	css_token_type first_type = CSS_TOKEN_NUMBER;
+	bool legacy = false;
+	const css_token *token;
+
+	for (unsigned i = 0; i < 3; i++) {
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+		if (i == 0 && token != NULL) {
+			first_type = token->type;
+			consumeWhitespace(vector, ctx);
+			legacy = tokenIsChar(parserutils_vector_peek(vector, *ctx), ',');
+		}
+		if (legacy && (token == NULL || token->type != first_type))
+			return CSS_INVALID;
+		if (ciuki_rgb_component(token, false, !legacy, legacy,
+				channels[i]) != CSS_OK)
+			return CSS_INVALID;
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+		if (i < 2 && legacy) {
+			if (!tokenIsChar(token, ','))
+				return CSS_INVALID;
+			parserutils_vector_iterate(vector, ctx);
+		}
+	}
+	if (tokenIsChar(token, legacy ? ',' : '/')) {
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_iterate(vector, ctx);
+		if (ciuki_rgb_component(token, true, !legacy, legacy, a) != CSS_OK)
+			return CSS_INVALID;
+		consumeWhitespace(vector, ctx);
+		token = parserutils_vector_peek(vector, *ctx);
+	}
+	if (!tokenIsChar(token, ')'))
+		return CSS_INVALID;
+	parserutils_vector_iterate(vector, ctx);
+	return CSS_OK;
+}
+
+/* Bare colors in quirks mode retain their old 3/6-digit grammar. */
+static css_error ciuki_parse_quirks_colour(lwc_string *data, uint32_t *result)
+{
+	size_t length = lwc_string_length(data);
+	if (length != 3 && length != 6)
+		return CSS_INVALID;
+	return css__parse_hash_colour(data, result);
+}
