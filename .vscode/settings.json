{
    // Assembly workspace with large vendored C trees. Excludes and low parsing
    // priority alone still left cpptools consuming a full CPU core on startup.
    // Disable its language engine here; C/C++ syntax coloring remains available.
    // After changing the engine, run Developer: Reload Window once.
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.default.browse.path": [],
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false,
    "makefile.configureOnOpen": false,
    "makefile.configureOnEdit": false,
    "C_Cpp.files.exclude": {
        "**": true
    },
    "C_Cpp.exclusionPolicy": "checkFilesAndFolders",
    "C_Cpp.workspaceParsingPriority": "low",
    "C_Cpp.intelliSenseCacheSize": 256,
    "files.exclude": {
        "**/build": true,
        "**/third_party": true,
        "**/handoff": true,
        "**/handoffs": true,
        "**/tmp": true,
        "**/.ciukios-testlogs": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/third_party/**": true,
        "**/handoff/**": true,
        "**/handoffs/**": true,
        "**/tmp/**": true,
        "**/.ciukios-testlogs/**": true
    },
    "search.exclude": {
        "**/build/**": true,
        "**/third_party/**": true,
        "**/handoff/**": true,
        "**/handoffs/**": true,
        "**/tmp/**": true,
        "**/.ciukios-testlogs/**": true
    }
}
