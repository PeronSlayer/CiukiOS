+;--- CiukiOS: release an exact XMS UMB allocation from a ring-0 JLOAD
+;--- module after a V86 VM has been killed.  EDX is its 16-bit segment.
+;--- EAX=1 only when this segment names a currently allocated UMB.
+;--- The caller owns the segment registry; no client frame is touched.
+UMB_release_direct proc public
+    push esi
+    mov esi,offset UMBsegments
+@@scan:
+    cmp [esi].UMBBLK.wSegm,dx
+    jne @@next
+    test byte ptr [esi].UMBBLK.wSize+1,UMB_ALLOCATED
+    jz @@bad
+    and byte ptr [esi].UMBBLK.wSize+1,not UMB_ALLOCATED
+    mov eax,1
+    pop esi
+    ret
+@@next:
+    add esi,size UMBBLK
+    cmp esi,offset UMBend
+    jne @@scan
+@@bad:
+    xor eax,eax
+    pop esi
+    ret
+UMB_release_direct endp
+
+;--- CiukiOS: claim one UMB for a VM in ring 0 and publish it only after the
+;--- CVSESSION owner record exists. EDX = paragraphs; EAX = segment or 0,
+;--- ECX = actual paragraphs. The ordinary XMS table remains authoritative.
+UMB_claim_direct proc public
+    push esi
+    push edi
+    push ebx
+    test edx,edx
+    jz @@bad
+    cmp edx,7FFFh
+    ja @@bad
+    mov esi,offset UMBsegments
+@@find:
+    cmp [esi].UMBBLK.wSegm,0
+    je @@next
+    test byte ptr [esi].UMBBLK.wSize+1,UMB_ALLOCATED
+    jne @@next
+    movzx ecx,[esi].UMBBLK.wSize
+    cmp edx,ecx
+    jbe @@found
+@@next:
+    add esi,size UMBBLK
+    cmp esi,offset UMBend
+    jne @@find
+    jmp @@bad
+@@found:
+    mov eax,edx
+    add eax,7Fh
+    and eax,not 7Fh
+    mov ebx,ecx
+    sub ebx,eax
+    cmp ebx,80h
+    jb @@whole
+    mov edi,offset UMBsegments
+@@slot:
+    cmp [edi].UMBBLK.wSegm,0
+    je @@split
+    add edi,size UMBBLK
+    cmp edi,offset UMBend
+    jne @@slot
+    jmp @@whole
+@@split:
+    mov bx,[esi].UMBBLK.wSegm
+    add bx,ax
+    mov [edi].UMBBLK.wSegm,bx
+    mov ebx,ecx
+    sub ebx,eax
+    mov [edi].UMBBLK.wSize,bx
+    mov [esi].UMBBLK.wSize,ax
+    mov ecx,eax
+@@whole:
+    or byte ptr [esi].UMBBLK.wSize+1,UMB_ALLOCATED
+    movzx eax,[esi].UMBBLK.wSegm
+    pop ebx
+    pop edi
+    pop esi
+    ret
+@@bad:
+    xor eax,eax
+    xor ecx,ecx
+    pop ebx
+    pop edi
+    pop esi
+    ret
+UMB_claim_direct endp
+
 .text$03 ends
 
