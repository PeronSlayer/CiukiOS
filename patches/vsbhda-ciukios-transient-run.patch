diff --git a/src/RUNEXEC.ASM b/src/RUNEXEC.ASM
new file mode 100644
index 0000000..3fac7f5
--- /dev/null
+++ b/src/RUNEXEC.ASM
@@ -0,0 +1,77 @@
+; Execute one child while VSBHDA remains the active DPMI client.  HDPMI's
+; protected-mode INT 21h/4B00 translator supports nested clients and waits
+; until the child returns.  Keeping the emulation layer non-TSR lets us tear
+; down PCI DMA, IRQ and port traps synchronously afterwards.
+
+	.386
+	.MODEL ?MODEL, c
+	option casemap:none
+
+	.data
+
+child_tail db 128 dup (0)
+
+ifdef NOTFLAT
+; HDPMI 16-bit protected-mode EXEC block: environment plus three 16:16 ptrs.
+child_block dw 0
+child_cmd   dd 0
+child_fcb1  dd 0
+child_fcb2  dd 0
+else
+; HDPMI 32-bit protected-mode EXEC block: three padded 16:32 ptrs, no env.
+child_cmd   dq 0
+child_fcb1  dq 0
+child_fcb2  dq 0
+endif
+
+	.code
+
+RunChild proc uses ebx ecx edx esi edi program:ptr, argument:ptr
+	mov byte ptr child_tail, 0
+	mov byte ptr child_tail+1, 13
+	mov esi, argument
+	test esi, esi
+	jz tail_ready
+	lea edi, child_tail+2
+	mov byte ptr child_tail+1, ' '
+	mov ecx, 1
+copy_tail:
+	cmp ecx, 126
+	jae tail_done
+	lodsb
+	test al, al
+	jz tail_done
+	stosb
+	inc ecx
+	jmp copy_tail
+tail_done:
+	mov byte ptr child_tail, cl
+	mov byte ptr [edi], 13
+tail_ready:
+ifdef NOTFLAT
+	mov word ptr child_cmd+0, offset child_tail
+	mov word ptr child_cmd+2, ds
+	mov edx, program
+	mov ebx, offset child_block
+else
+	mov dword ptr child_cmd+0, offset child_tail
+	mov word ptr child_cmd+4, ds
+	mov edx, program
+	mov ebx, offset child_cmd
+endif
+	push ds
+	pop es
+	mov ax, 4B00h
+	int 21h
+	jc exec_error
+	mov ah, 4Dh
+	int 21h
+	movzx eax, al
+	ret
+exec_error:
+	movzx eax, ax
+	or eax, 80000000h
+	ret
+RunChild endp
+
+	END

