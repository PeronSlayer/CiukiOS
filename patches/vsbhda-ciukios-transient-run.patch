@@ -109,6 +110,12 @@ struct SNDISR_s {
 
 static struct SNDISR_s isr = {NULL,-1,0,0};
 
+/* IRQ-side accounting only: no DOS, BIOS, printing or file calls here. */
+static volatile uint32_t diag_irqs;
+static volatile uint32_t diag_pcm_blocks;
+static volatile uint32_t diag_opl_blocks;
+static volatile uint32_t diag_nonzero_blocks;
+
 #ifndef DJGPP
 /* here malloc/free is superfast since it's a very simple "stack" */
 #define MALLOCSTATIC 0
@@ -278,6 +285,7 @@ static int SNDISR_Interrupt( void )
     /* check if the sound hw does request an interrupt. */
     if( !AU_isirq( isr.hAU ) )
         return(0);
+    diag_irqs++;
 
 #if COMPAT4
     /* v1.8: /CF4 */
@@ -580,6 +588,8 @@ static int SNDISR_Interrupt( void )
     }
 
     /* get volumes for software mixer */
+    if( IdxSm )
+        diag_pcm_blocks++;
 
     if( gvars.type < 4) { //SB2.0 and before
         mastervol = (VSB_GetMixerReg( SB_MIXERREG_MASTERVOL) & 0xF) << 4; /* 3 bits (1-3) */
@@ -623,6 +633,7 @@ static int SNDISR_Interrupt( void )
 #ifndef NOFM
     if( VOPL3_IsActive() ) {
         int channels;
+        diag_opl_blocks++;
         pPCMOPL = IdxSm ? isr.pPCM + nSamples * 2 : isr.pPCM;
         VOPL3_GenSamples( pPCMOPL, nSamples ); //will generate samples*2 if stereo
         //always use 2 channels
@@ -697,6 +708,15 @@ static int SNDISR_Interrupt( void )
         fpu_restore( fpu_buffer );
     }
 #endif
+    /* Record whether the actual post-mixer output contains a signal.
+     * This does not claim that the analogue speaker emitted sound. */
+    for( i = 0; i < nSamples * 2; i++ ) {
+        if( isr.pPCM[i] ) {
+            diag_nonzero_blocks++;
+            break;
+        }
+    }
+
     AU_writedata( isr.hAU, isr.pPCM, nSamples * 2 );
 
 #if SLOWDOWN
@@ -731,6 +751,21 @@ void SNDISR_IrqOnPortAcc( void )
 
 /* init sound hw - called by main() */
 
+/* Called after the transient child returns and the controller is stopped. */
+void SNDISR_Report( void )
+{
+    printf("AUDIO: card=%s HWIRQ=%u rate=%u PIC=%04X\n",
+        AU_getshortname(isr.hAU), AU_getirq(isr.hAU),
+        AU_getfreq(isr.hAU), PIC_GetIRQMask());
+    printf("AUDIO: IRQ=%u PCM=%u OPL=%u OUT=%u\n",
+        diag_irqs, diag_pcm_blocks, diag_opl_blocks, diag_nonzero_blocks);
+    printf("AUDIO: SB mixer master=%02X voice=%02X midi=%02X\n",
+        VSB_GetMixerReg(SB_MIXERREG_MASTERSTEREO),
+        VSB_GetMixerReg(SB_MIXERREG_VOICESTEREO),
+        VSB_GetMixerReg(SB_MIXERREG_MIDISTEREO));
+    printf("AUDIO: OUT counts non-silent digital blocks, not speaker verification\n");
+}
