+;--- Install/remove one exact callback.  ESI is the callback address.  A
+;--- different owner can neither overwrite nor remove the live pointer.
+
+Install_Host_Scheduler proc
+	mov eax,[ppHostScheduler]
+	test eax,eax
+	jz short scheduler_error
+	cmp dword ptr [eax],0
+	jne short scheduler_error
+	mov [eax],esi
+	clc
+	ret
+Install_Host_Scheduler endp
+
+Remove_Host_Scheduler proc
+	mov eax,[ppHostScheduler]
+	test eax,eax
+	jz short scheduler_error
+	cmp [eax],esi
+	jne short scheduler_error
+	mov dword ptr [eax],0
+	clc
+	ret
+Remove_Host_Scheduler endp
+
+scheduler_error:
+	stc
+	ret
+
+;--- Versioned run-time negotiation of the Jemm interrupt profile. EAX is
+;--- the function, ECX its argument. A Jemm built without the profile answers
+;--- EAX=0 (no version, nothing available) instead of failing.
+
+Host_Scheduler_Profile proc
+	; Every register is an argument (function 7 passes its value in EDX).
+	cmp [ppProfileService],0
+	je short profile_absent
+	jmp [ppProfileService]
+profile_absent:
+	xor eax,eax
+	clc
+	ret
+Host_Scheduler_Profile endp
+
