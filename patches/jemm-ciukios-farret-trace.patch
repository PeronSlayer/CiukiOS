@@ -2062,6 +2122,85 @@
     align 4
 Simulate_Far_Ret endp
 
+ifdef CIUKIOS_FARRET_TRACE
+; 40-byte record layout: sequence, kind (0=RETF, 1=CALL), SS:SP,
+; source CS, source IP, EAX, target CS:IP, protected-mode caller EIP,
+; Client_Int, Client_EFlags. Ring arithmetic is bounded.
+CvFarRetTraceRecord proc near
+    push ebx
+    push esi
+    push edi
+    cmp CvFarRetTraceFrozen, 0
+    jne CvFarRetTraceRecordDone
+    mov esi, ebp
+    mov eax, CvFarRetTraceNext
+    and eax, 31
+    imul eax, eax, 40
+    lea edi, CvFarRetTraceRecords[eax]
+
+    mov ecx, CvFarRetTraceSequence
+    inc ecx
+    mov CvFarRetTraceSequence, ecx
+    mov [edi], ecx
+    mov eax, [esp+16]        ; operation kind argument
+    mov [edi+4], eax
+
+    movzx eax, word ptr [esi].Client_Reg_Struc.Client_ESP
+    movzx ebx, word ptr [esi].Client_Reg_Struc.Client_SS
+    shl ebx, 16
+    or eax, ebx
+    mov [edi+8], eax
+    mov eax, [esi].Client_Reg_Struc.Client_CS
+    mov [edi+12], eax
+    mov eax, [esi].Client_Reg_Struc.Client_EIP
+    mov [edi+16], eax
+    mov eax, [esi].Client_Reg_Struc.Client_EAX
+    mov [edi+20], eax
+
+    cmp dword ptr [esp+16], 0
+    jne short CvFarRetTraceUseArgumentTarget
+    movzx ecx, word ptr [esi].Client_Reg_Struc.Client_SS
+    shl ecx, 4
+    movzx edx, word ptr [esi].Client_Reg_Struc.Client_ESP
+    movzx eax, word ptr [ecx+edx]
+    movzx ebx, word ptr [esi].Client_Reg_Struc.Client_ESP
+    add bx, 2
+    movzx edx, bx
+    movzx ebx, word ptr [ecx+edx]
+    shl ebx, 16
+    or eax, ebx
+    jmp short CvFarRetTraceStoreTarget
+CvFarRetTraceUseArgumentTarget:
+    mov eax, [esp+20]        ; packed target CS:IP argument
+CvFarRetTraceStoreTarget:
+    mov [edi+24], eax
+
+    ; Two arguments make helper ESP 60 bytes below either caller entry ESP.
+    mov eax, [esp+60]
+    mov [edi+28], eax
+    mov eax, [esi].Client_Reg_Struc.Client_Int
+    mov [edi+32], eax
+    mov eax, [esi].Client_Reg_Struc.Client_EFlags
+    mov [edi+36], eax
+
+    mov eax, CvFarRetTraceNext
+    inc eax
+    and eax, 31
+    mov CvFarRetTraceNext, eax
+    mov eax, CvFarRetTraceCount
+    cmp eax, 32
+    jae short CvFarRetTraceCountReady
+    inc eax
+    mov CvFarRetTraceCount, eax
+CvFarRetTraceCountReady:
+CvFarRetTraceRecordDone:
+    pop edi
+    pop esi
+    pop ebx
+    ret
+CvFarRetTraceRecord endp
+endif
+
