--- a/src/XMS.ASM
+++ b/src/XMS.ASM
@@ -66,7 +66,22 @@
 
 ;--- registers EAX, ECX and ESI dont hold client values!
 
+ifdef CIUKIOS_V86_INTERRUPTS
+externdef CvXmsDepth:dword
+endif
+
 xms_handler proc public
+ifdef CIUKIOS_V86_INTERRUPTS
+    inc CvXmsDepth
+endif
+    call xms_handler_body
+ifdef CIUKIOS_V86_INTERRUPTS
+    dec CvXmsDepth
+endif
+    ret
+xms_handler endp
+
+xms_handler_body proc
     call Simulate_Far_Ret                       ; emulate a RETF in v86, modifies EDX
     mov eax,[ebp].Client_Reg_Struc.Client_EAX   ; restore EAX
     mov edx,[ebp].Client_Reg_Struc.Client_EDX   ; restore EDX
@@ -163,7 +178,7 @@
   endif
 endif
 
-xms_handler endp
+xms_handler_body endp
 
