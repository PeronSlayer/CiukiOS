--- a/dlls/setupapi/parser.c
+++ b/dlls/setupapi/parser.c
@@ -38,6 +38,36 @@
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(setupapi);
+
+/* CiukiOS: these modules link the single system msvcrt.dll instead of
+ * ucrtbase.dll. _recalloc is an MSVCR80+ export, so keep its documented
+ * semantics locally: grow/shrink, zero the added bytes, fail on overflow. */
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+static void *ciuki_recalloc(void *mem, size_t num, size_t size)
+{
+    size_t old_size, total;
+    void *ret;
+
+    if (!mem) return calloc(num, size);
+    if (size && num > (size_t)-1 / size)
+    {
+        errno = ENOMEM;
+        return NULL;
+    }
+    total = num * size;
+    old_size = _msize(mem);
+    ret = realloc(mem, total);
+    if (!ret)
+    {
+        errno = ENOMEM;
+        return NULL;
+    }
+    if (total > old_size) memset((char *)ret + old_size, 0, total - old_size);
+    return ret;
+}
+#define _recalloc ciuki_recalloc
 
