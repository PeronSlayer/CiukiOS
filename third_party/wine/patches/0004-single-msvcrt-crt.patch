@@ -39,6 +39,20 @@
 #include "resource.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(shell);
+
+/* CiukiOS: msvcrt.dll has no C99 round(); round half away from zero exactly
+ * (x - floor(x) is exact for doubles), as the MSVCR120+ export does. */
+#include <math.h>
+static double ciuki_round(double x)
+{
+    double r;
+
+    if (x < 0.0) return -ciuki_round(-x);
+    r = floor(x);
+    if (x - r >= 0.5) r += 1.0;
+    return r;
+}
+#define round ciuki_round
 
