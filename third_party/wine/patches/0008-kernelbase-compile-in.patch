+static BOOL char_class( WCHAR wc, WORD mask )
+{
+    WORD type;
+    return GetStringTypeW( CT_CTYPE1, &wc, 1, &type ) && (type & mask);
+}
+
+BOOL WINAPI IsCharBlankW( WCHAR wc )
+{
+    return char_class( wc, C1_BLANK );
+}
+
+BOOL WINAPI IsCharCntrlW( WCHAR wc )
+{
+    return char_class( wc, C1_CNTRL );
+}
+
+BOOL WINAPI IsCharDigitW( WCHAR wc )
+{
+    return char_class( wc, C1_DIGIT );
+}
+
+BOOL WINAPI IsCharPunctW( WCHAR wc )
+{
+    return char_class( wc, C1_PUNCT );
+}
+
+BOOL WINAPI IsCharSpaceA( CHAR c )
+{
+    WCHAR wc;
+    return MultiByteToWideChar( CP_ACP, 0, &c, 1, &wc, 1 ) && char_class( wc, C1_SPACE );
+}
+
+BOOL WINAPI IsCharSpaceW( WCHAR wc )
+{
+    return char_class( wc, C1_SPACE );
+}
+
+BOOL WINAPI IsCharXDigitW( WCHAR wc )
+{
+    return char_class( wc, C1_XDIGIT );
+}
