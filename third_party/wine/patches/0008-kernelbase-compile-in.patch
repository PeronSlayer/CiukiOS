+/* CharNextExA (a private copy here) tests lead bytes with IsDBCSLeadByteEx,
+ * which the CiukiOS KERNEL32 does not export; the documented rule over the
+ * code page's lead-byte ranges (GetCPInfo) gives the same answer. */
+static BOOL shlwapi_IsDBCSLeadByteEx( UINT codepage, BYTE ch )
+{
+    CPINFO info;
+    unsigned int i;
+
+    if (!GetCPInfo( codepage, &info )) return FALSE;
+    for (i = 0; i + 1 < MAX_LEADBYTES && info.LeadByte[i]; i += 2)
+        if (ch >= info.LeadByte[i] && ch <= info.LeadByte[i + 1]) return TRUE;
+    return FALSE;
+}
