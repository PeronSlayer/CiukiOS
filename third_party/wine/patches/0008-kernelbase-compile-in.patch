+    ret = SHRegOpenUSKeyA(subkey, KEY_ALL_ACCESS, 0, &hkey, ignore_hkcu);
+    if (ret == ERROR_SUCCESS)
+    {
+        ret = SHRegWriteUSValueA(hkey, value, type, data, data_len, flags);
+        SHRegCloseUSKey(hkey);
+    }
+
+    return ret;
