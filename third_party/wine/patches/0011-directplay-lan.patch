+static BOOL CALLBACK DPWS_ReadAddress( REFGUID type, DWORD size, const void *value, void *context )
+{
+    DPWS_DATA *state = context;
+    char text[256];
+    const char *address = value;
+    struct hostent *host;
+    if (IsEqualGUID( type, &DPAID_INetW ))
+    {
+        const WCHAR *wide = value;
+        DWORD i;
+        if (size < sizeof(WCHAR) || size % sizeof(WCHAR) || size / sizeof(WCHAR) > sizeof(text))
+            return TRUE;
+        for (i = 0; i < size / sizeof(WCHAR); ++i)
+        {
+            if (wide[i] > 127) return TRUE;
+            text[i] = wide[i];
+        }
+        address = text;
+        size /= sizeof(WCHAR);
+    }
+    else if (!IsEqualGUID( type, &DPAID_INet )) return TRUE;
+    if (!size || size > sizeof(text) || address[size - 1]) return TRUE;
+    state->targetChosen = TRUE;
+    state->enumTarget = INADDR_BROADCAST;
+    if (!*address) return TRUE;
+    state->enumTarget = inet_addr( address );
+    if (state->enumTarget != INADDR_NONE) return TRUE;
+    host = gethostbyname( address );
+    if (!host || host->h_addrtype != AF_INET || host->h_length != 4 || !host->h_addr_list[0])
+    {
+        state->addressInvalid = TRUE;
+        return FALSE;
+    }
+    memcpy( &state->enumTarget, host->h_addr_list[0], 4 );
+    return TRUE;
+}
+
+static INT_PTR CALLBACK DPWS_AddressDialog( HWND dialog, UINT message, WPARAM wparam, LPARAM lparam )
+{
+    DPWS_DATA *state;
+    char text[256];
+    if (message == WM_INITDIALOG)
+    {
+        SetWindowLongPtrW( dialog, DWLP_USER, lparam );
+        return TRUE;
+    }
+    if (message != WM_COMMAND) return FALSE;
+    if (LOWORD(wparam) == IDCANCEL) { EndDialog( dialog, IDCANCEL ); return TRUE; }
+    if (LOWORD(wparam) != IDOK) return FALSE;
+    state = (DPWS_DATA *)GetWindowLongPtrW( dialog, DWLP_USER );
+    GetDlgItemTextA( dialog, 102, text, sizeof(text) );
+    state->addressInvalid = FALSE;
+    DPWS_ReadAddress( &DPAID_INet, strlen(text) + 1, text, state );
+    if (state->addressInvalid)
+    {
+        MessageBoxW( dialog, L"The address could not be resolved.", L"DirectPlay", MB_OK );
+        return TRUE;
+    }
+    EndDialog( dialog, IDOK );
+    return TRUE;
 }
 
