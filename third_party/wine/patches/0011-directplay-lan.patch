+/* TCP is a byte stream: a successful short write is not a dropped message. */
+static HRESULT DPWS_WriteAll( SOCKET sock, const void *buffer, DWORD size )
+{
+    const char *cursor = buffer;
+    while (size)
+    {
+        int count = send( sock, cursor, size, 0 );
+        if (count == SOCKET_ERROR && WSAGetLastError() == WSAEINTR) continue;
+        if (count <= 0 || count > size) return DPERR_CONNECTIONLOST;
+        cursor += count;
+        size -= count;
+    }
+    return DP_OK;
+}
 
