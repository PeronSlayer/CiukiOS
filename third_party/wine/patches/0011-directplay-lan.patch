+/* Called only by the receive thread. The enumeration socket is nonblocking. */
+static void DPWS_ReceiveEnum( DPWS_DATA *state )
+{
+    SOCKADDR_IN source;
+    DPSP_MSG_HEADER *header = (DPSP_MSG_HEADER *)state->enumBuffer;
+    int sourceSize = sizeof(source), count;
+    WSANETWORKEVENTS events;
+    DWORD magic;
+    if (state->enumSock == INVALID_SOCKET) return;
+    if (WSAEnumNetworkEvents( state->enumSock, state->enumEvent, &events )) return;
+    count = recvfrom( state->enumSock, state->enumBuffer, sizeof(state->enumBuffer), 0,
+                     (SOCKADDR *)&source, &sourceSize );
+    if (count <= 0 || (unsigned)count < sizeof(*header) + 8 || sourceSize != sizeof(source)) return;
+    memcpy( &magic, state->enumBuffer + sizeof(*header), sizeof(magic) );
+    if (DPSP_MSG_SIZE(header->mixed) != count || magic != 0x79616c70 ||
+        state->enumBuffer[sizeof(*header) + 4] != 2 ||
+        state->enumBuffer[sizeof(*header) + 5] != 0 ||
+        DPSP_MSG_TOKEN(header->mixed) != DPSP_MSG_TOKEN_REMOTE ||
+        header->SockAddr.sin_family != AF_INET || !header->SockAddr.sin_port) return;
+    header->SockAddr.sin_addr = source.sin_addr;
+    IDirectPlaySP_HandleMessage( state->lpISP, state->enumBuffer + sizeof(*header),
+                                count - sizeof(*header), header );
 }
 
