-static DWORD CALLBACK DPL_MSG_ThreadMain( LPVOID lpContext );
+    HANDLE start,death,read,notify,process,abort;
+    DWORD appid;
+} MSGTHREADINFO;
+
+static void DPL_MSG_Free(MSGTHREADINFO *info)
+{
+    HANDLE handles[]={info->start,info->death,info->read,info->notify,info->process,info->abort};
+    for(unsigned i=0;i<ARRAY_SIZE(handles);i++) if(handles[i]) CloseHandle(handles[i]);
+    free(info);
+}
+static DWORD CALLBACK DPL_MSG_ThreadMain(void *context)
+{
+    MSGTHREADINFO *info=context;
+    HANDLE stages[]={info->start,info->read};
+    for(unsigned i=0;i<ARRAY_SIZE(stages);i++) {
+        HANDLE wait[]={info->abort,info->process,stages[i]};
+        if(WaitForMultipleObjects(3,wait,FALSE,INFINITE)!=WAIT_OBJECT_0+2) goto done;
+        if(info->notify) SetEvent(info->notify);
+    }
+    HANDLE wait[]={info->abort,info->process};
+    WaitForMultipleObjects(2,wait,FALSE,INFINITE);
+    if(info->notify) SetEvent(info->notify);
+done:
+    DPLAYX_ReleaseLobbyApplication(info->appid);
+    DPL_MSG_Free(info);
+    return 0;
+}
+DWORD CreateLobbyMessageReceptionThread(HANDLE notify,HANDLE start,HANDLE death,HANDLE read,
+                                        HANDLE process,HANDLE abort,DWORD appid)
+{
+    MSGTHREADINFO *info=calloc(1,sizeof(*info));
+    HANDLE thread; DWORD id=0;
+    if(!info) return 0;
+    HANDLE self=GetCurrentProcess();
+    if((notify && !DuplicateHandle(self,notify,self,&info->notify,0,FALSE,DUPLICATE_SAME_ACCESS)) ||
+       !DuplicateHandle(self,process,self,&info->process,0,FALSE,DUPLICATE_SAME_ACCESS) ||
+       !DuplicateHandle(self,abort,self,&info->abort,0,FALSE,DUPLICATE_SAME_ACCESS)) goto failed;
+    info->start=start;info->death=death;info->read=read;info->appid=appid;
+    thread=CreateThread(NULL,0,DPL_MSG_ThreadMain,info,0,&id);
+    if(!thread) goto failed;
+    CloseHandle(thread);return id;
+failed:
+    /* On failure, the caller still owns its three input events. */
+    info->start=info->death=info->read=NULL;
+    DPL_MSG_Free(info);return 0;
+}
