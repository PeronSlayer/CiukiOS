+static char *DPL_Ansi( const WCHAR *text )
+{
+    int size;
+    char *result;
+    if (!text) return NULL;
+    size = WideCharToMultiByte(CP_ACP, 0, text, -1, NULL, 0, NULL, NULL);
+    if (size <= 0 || !(result = malloc(size))) return NULL;
+    if (!WideCharToMultiByte(CP_ACP, 0, text, -1, result, size, NULL, NULL))
+    { free(result); return NULL; }
+    return result;
+}
