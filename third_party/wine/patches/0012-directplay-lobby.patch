+extern DPSESSIONDESC2 *DP_DuplicateSessionDesc( const DPSESSIONDESC2 *, BOOL, BOOL );
+static HRESULT WINAPI IDirectPlayLobby3Impl_RunApplication( IDirectPlayLobby3 *iface, DWORD flags,
+        DWORD *appId, DPLCONNECTION *connection, HANDLE receiveEvent )
+{
+    IDirectPlayLobbyImpl *This = impl_from_IDirectPlayLobby3(iface);
+    DPLCONNECTION ansi;
+    DPNAME name;
+    DPSESSIONDESC2 *session;
+    HRESULT hr;
+    if (flags || !appId || !connection || connection->dwSize != sizeof(*connection) ||
+        !connection->lpSessionDesc || connection->lpSessionDesc->dwSize != sizeof(DPSESSIONDESC2))
+        return DPERR_INVALIDPARAMS;
+    *appId = 0;
+    session = DP_DuplicateSessionDesc(connection->lpSessionDesc, TRUE, FALSE);
+    if (!session) return DPERR_OUTOFMEMORY;
+    ansi = *connection;
+    ansi.lpSessionDesc = session;
+    if (connection->lpPlayerName)
+    {
+        name = *connection->lpPlayerName;
+        name.lpszShortNameA = DPL_Ansi(connection->lpPlayerName->lpszShortName);
+        name.lpszLongNameA = DPL_Ansi(connection->lpPlayerName->lpszLongName);
+        if ((connection->lpPlayerName->lpszShortName && !name.lpszShortNameA) ||
+            (connection->lpPlayerName->lpszLongName && !name.lpszLongNameA))
+        { free(name.lpszShortNameA); free(name.lpszLongNameA); free(session); return DPERR_OUTOFMEMORY; }
