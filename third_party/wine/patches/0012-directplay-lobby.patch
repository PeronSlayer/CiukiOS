+/* The public A/W records have identical pointer layouts. Convert only text. */
+static WCHAR *DPL_Wide( const void *text, BOOL ansi )
+{
+    WCHAR *result;
+    int count;
+    if (!text) text = ansi ? (const void *)"" : (const void *)L"";
+    count = ansi ? MultiByteToWideChar(CP_ACP, 0, text, -1, NULL, 0) : lstrlenW(text) + 1;
+    if (count <= 0 || count > 32768) return NULL;
+    if (!(result = malloc(count * sizeof(WCHAR)))) return NULL;
+    if (ansi) MultiByteToWideChar(CP_ACP, 0, text, -1, result, count);
+    else memcpy(result, text, count * sizeof(WCHAR));
+    return result;
+}
+
+static HRESULT DPL_Register( DWORD flags, DPAPPLICATIONDESC *app, BOOL ansi )
+{
+    static const WCHAR *names[] = {L"File", L"CommandLine", L"Path", L"CurrentDirectory"};
+    const void *input[5];
+    WCHAR *text[5] = {0}, guid[40];
+    HKEY parent, key;
+    LONG error;
+    DWORD i;
+    HRESULT hr = DPERR_OUTOFMEMORY;
+    if (flags || !app || app->dwSize != sizeof(*app) || app->dwFlags ||
+        !app->lpszApplicationName || !app->lpszFilename ||
+        IsEqualGUID(&app->guidApplication, &GUID_NULL)) return DPERR_INVALIDPARAMS;
+    input[0] = app->lpszApplicationName;
+    input[1] = app->lpszFilename;
+    input[2] = app->lpszCommandLine;
+    input[3] = app->lpszPath;
+    input[4] = app->lpszCurrentDirectory;
+    for (i = 0; i < 5; ++i) if (!(text[i] = DPL_Wide(input[i], ansi))) goto done;
+    if (!text[0][0] || !text[1][0]) { hr = DPERR_INVALIDPARAMS; goto done; }
+    for (i = 0; text[0][i]; ++i)
+        if (text[0][i] == '\\' || text[0][i] == '/') { hr = DPERR_INVALIDPARAMS; goto done; }
+    if (!StringFromGUID2(&app->guidApplication, guid, ARRAY_SIZE(guid))) goto done;
+    error = RegCreateKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\DirectPlay\\Applications",
+                            0, NULL, 0, KEY_READ | KEY_WRITE, NULL, &parent, NULL);
+    if (error) { hr = DPERR_ACCESSDENIED; goto done; }
+    error = RegCreateKeyExW(parent, text[0], 0, NULL, 0, KEY_READ | KEY_WRITE, NULL, &key, NULL);
+    RegCloseKey(parent);
+    if (error) { hr = DPERR_ACCESSDENIED; goto done; }
+    error = RegSetValueExW(key, L"Guid", 0, REG_SZ, (const BYTE *)guid, (lstrlenW(guid) + 1) * sizeof(WCHAR));
+    for (i = 0; i < 4 && !error; ++i)
+        error = RegSetValueExW(key, names[i], 0, REG_SZ, (const BYTE *)text[i + 1],
+                               (lstrlenW(text[i + 1]) + 1) * sizeof(WCHAR));
+    RegCloseKey(key);
+    hr = error ? DPERR_ACCESSDENIED : DP_OK;
+done:
+    for (i = 0; i < 5; ++i) free(text[i]);
+    return hr;
+}
+
+static HRESULT DPL_Unregister( DWORD flags, REFGUID guid )
+{
+    HKEY parent, key;
+    WCHAR name[256], value[40], wanted[40];
+    DWORD index = 0, length, bytes, type;
+    LONG error;
+    if (flags || !guid || IsEqualGUID(guid, &GUID_NULL)) return DPERR_INVALIDPARAMS;
+    StringFromGUID2(guid, wanted, ARRAY_SIZE(wanted));
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\DirectPlay\\Applications",
+                       0, KEY_READ | KEY_WRITE, &parent)) return DPERR_UNKNOWNAPPLICATION;
+    for (;; ++index)
+    {
+        length = ARRAY_SIZE(name);
+        error = RegEnumKeyExW(parent, index, name, &length, NULL, NULL, NULL, NULL);
+        if (error == ERROR_NO_MORE_ITEMS) break;
+        if (error) { RegCloseKey(parent); return DPERR_ACCESSDENIED; }
+        if (RegOpenKeyExW(parent, name, 0, KEY_READ, &key)) continue;
+        bytes = sizeof(value);
+        error = RegQueryValueExW(key, L"Guid", NULL, &type, (BYTE *)value, &bytes);
+        RegCloseKey(key);
+        if (error || type != REG_SZ || bytes < sizeof(WCHAR) || bytes > sizeof(value) ||
+            bytes % sizeof(WCHAR) || value[bytes / sizeof(WCHAR) - 1] || lstrcmpiW(value, wanted)) continue;
+        error = RegDeleteKeyW(parent, name);
+        RegCloseKey(parent);
+        return error ? DPERR_ACCESSDENIED : DP_OK;
+    }
+    RegCloseKey(parent);
+    return DPERR_UNKNOWNAPPLICATION;
+}
