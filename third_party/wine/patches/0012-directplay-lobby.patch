+static HRESULT DPL_EnumApplications( IDirectPlayLobbyImpl *This,
+        LPDPLENUMLOCALAPPLICATIONSCALLBACK callback, void *context, DWORD flags, BOOL ansi )
+{
+    HKEY parent, key;
+    DWORD index = 0, length, bytes, type;
+    WCHAR name[256], value[40];
+    char ansiName[1024];
+    DPLAPPINFO info;
+    LONG error;
+    BOOL more;
+    HRESULT hr = DP_OK;
+    if (flags || !callback) return DPERR_INVALIDPARAMS;
+    error = RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\DirectPlay\\Applications",
+                          0, KEY_READ, &parent);
+    if (error == ERROR_FILE_NOT_FOUND) return DP_OK;
+    if (error) return DPERR_ACCESSDENIED;
+    for (;; ++index)
+    {
+        length = ARRAY_SIZE(name);
+        error = RegEnumKeyExW(parent, index, name, &length, NULL, NULL, NULL, NULL);
+        if (error == ERROR_NO_MORE_ITEMS) break;
+        if (error) { hr = DPERR_ACCESSDENIED; break; }
+        if (RegOpenKeyExW(parent, name, 0, KEY_READ, &key)) continue;
+        bytes = sizeof(value);
+        error = RegQueryValueExW(key, L"Guid", NULL, &type, (BYTE *)value, &bytes);
+        if (error || type != REG_SZ || bytes < sizeof(WCHAR) || bytes > sizeof(value) ||
+            bytes % sizeof(WCHAR) || value[bytes / sizeof(WCHAR) - 1] ||
+            FAILED(CLSIDFromString(value, &info.guidApplication)))
+        { RegCloseKey(key); continue; }
+        info.dwSize = sizeof(info);
+        if (ansi)
+        {
+            if (!WideCharToMultiByte(CP_ACP, 0, name, -1, ansiName, sizeof(ansiName), NULL, NULL))
+            { RegCloseKey(key); continue; }
+            info.lpszAppNameA = ansiName;
+        }
+        else info.lpszAppName = name;
+        EnterCriticalSection(&This->lock);
+        This->cbkeyhack = key;
+        more = callback(&info, context, 0);
+        This->cbkeyhack = NULL;
+        LeaveCriticalSection(&This->lock);
+        RegCloseKey(key);
+        if (!more) break;
+    }
+    RegCloseKey(parent);
+    return hr;
+}
