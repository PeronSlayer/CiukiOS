+static char *DPL_QueryStringA( HKEY key, const char *name )
+{
+    DWORD size = 0, type;
+    char *text;
+    LONG error = RegQueryValueExA(key, name, NULL, &type, NULL, &size);
+    if (error == ERROR_FILE_NOT_FOUND) return strdup("");
+    if (error || type != REG_SZ || !size || size > 32768) return NULL;
+    if (!(text = malloc(size))) return NULL;
+    if (RegQueryValueExA(key, name, NULL, &type, (BYTE *)text, &size) ||
+        type != REG_SZ || !size || text[size - 1]) { free(text); return NULL; }
+    return text;
+}
