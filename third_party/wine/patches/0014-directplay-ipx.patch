 #define DPWS_START_UDP_PORT 2350
 #define DPWS_END_UDP_PORT   2400
 
+/* IPX uses the existing 16-byte carrier, copied without aliasing. Its wire
+ * profile is a documented CiukiOS choice; see docs/design/directplay.md. */
+static int DPWS_Family(const DPWS_DATA *s) { return s->ipx ? AF_IPX : AF_INET; }
+static int DPWS_Protocol(const DPWS_DATA *s, BOOL stream)
+{ return s->ipx ? (stream ? NSPROTO_SPX : NSPROTO_IPX) : (stream ? IPPROTO_TCP : IPPROTO_UDP); }
+static int DPWS_AddrSize(const SOCKADDR_IN *a)
+{ return a->sin_family==AF_IPX ? sizeof(SOCKADDR_IPX) : sizeof(*a); }
+static WORD DPWS_Port(const SOCKADDR_IN *a)
+{ WORD port; if(a->sin_family!=AF_IPX) return a->sin_port; memcpy(&port,(const char *)a+12,2); return port; }
+static void DPWS_Address(DPWS_DATA *s, SOCKADDR_IN *a, WORD port, BOOL broadcast)
+{
+    memset(a,0,sizeof(*a));
+    if(s->ipx) {
+        SOCKADDR_IPX ipx={0}; ipx.sa_family=AF_IPX; ipx.sa_socket=port;
+        if(broadcast) memset(ipx.sa_nodenum,255,6);
+        memcpy(a,&ipx,sizeof(ipx));
+    } else { a->sin_family=AF_INET; a->sin_port=port; a->sin_addr.s_addr=broadcast ? s->enumTarget : INADDR_ANY; }
+}
+static void DPWS_Node(SOCKADDR_IN *to, const SOCKADDR_IN *from)
+{
+    if(to->sin_family==AF_IPX) memcpy((char *)to+2,(const char *)from+2,10);
+    else to->sin_addr=from->sin_addr;
+}
+static void DPWS_CompleteAddress(SOCKADDR_IN *to, const SOCKADDR_IN *from)
+{
+    static const char zero[10];
+    if(to->sin_family!=from->sin_family) return;
+    if(to->sin_family==AF_IPX) { if(!memcmp((char *)to+2,zero,10)) DPWS_Node(to,from); }
+    else if(!to->sin_addr.s_addr) DPWS_Node(to,from);
+}
